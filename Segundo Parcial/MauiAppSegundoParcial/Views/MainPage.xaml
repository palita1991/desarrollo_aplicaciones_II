<?xml version="1.0" encoding="utf-8" ?>
<!-- x:DataType habilita los Compiled Bindings -->
    <ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAppSegundoParcial.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppSegundoParcial.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             x:Name="RootPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="15">
             <Label Text="Listado de Usuarios"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}" 
               HorizontalOptions="Center" />
            <!-- ESTADO 1: Sin datos -->
            <Button Text="Cargar Datos"
                    Command="{Binding LoadDataCommand}"
                    Margin="0,0,0,15"
                    WidthRequest="250"
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasData, Converter={x:StaticResource InvertedBoolConverter}}"
                    IsEnabled="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}" />

            <!-- ESTADO 2: Listado completo -->
            <Grid ColumnDefinitions="*, *" 
                  ColumnSpacing="15" 
                  Margin="0,0,0,15" 
                  Padding="10,0"
                  IsVisible="{Binding HasData}">

                <Button Grid.Column="0"
                        Text="Cargar Datos"
                        Command="{Binding LoadDataCommand}"
                        IsEnabled="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}" />

                <Button Grid.Column="1"
                        Text="+ Agregar"
                        Command="{Binding GoToAddCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White" />
            </Grid>
            <SearchBar Placeholder="Buscar por nombre o correo..."
                       Text="{Binding SearchQuery}"
                       CancelButtonColor="Red"
                       IsVisible="{Binding HasData}"/>
            <!-- Mensaje de estado resultante -->
		    <Label Text="{Binding StatusMessage}"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

		    <!-- Indicador de carga de datos -->
		    <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </VerticalStackLayout>
        <!-- CollectionView para el listado -->
        <CollectionView Grid.Row="1"
                    ItemsSource="{Binding Users}"
                    SelectionMode="None"
                    IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="10,5" Padding="15" CornerRadius="8" HasShadow="True">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <!-- Columna 0: Datos apilados del usuario -->
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Nombre:" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Name}"  FontSize="16" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Usuario:" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Username}" FontSize="16" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Email:" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Email}" FontSize="16" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Teléfono:" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Phone}" FontSize="16" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="10">
                                    <Button Text="Ver"
                                            Command="{Binding BindingContext.GoToDetailsCommand, Source={x:Reference RootPage}}"
                                            CommandParameter="{Binding Id}" />
                                    <Button Text="Eliminar" 
                                            BackgroundColor="DarkRed"
                                            TextColor="White"
                                            Command="{Binding BindingContext.DeleteCommand, Source={x:Reference RootPage}}"
                                            CommandParameter="{Binding Id}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

    </Grid>

</ContentPage>
