<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAppSegundoParcial.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppSegundoParcial.Views.AddUserPage"
             x:DataType="viewmodels:AddUserViewModel">

    <!-- 1. Declaramos el convertidor para que el Frame pueda usar IsVisible -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            <Frame CornerRadius="20"
                   HasShadow="True"
                   WidthRequest="350"
                   HorizontalOptions="Center"
                   BorderColor="{StaticResource Primary}"
                   IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Padding="10">
                    <!-- Campos del formulario -->
                    <Label Text="NOMBRE COMPLETO*" 
                           FontSize="18" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center"/>
                    <Entry Text="{Binding Name}" FontSize="16" WidthRequest="300" />
                    <Label Text="USUARIO" 
                           FontSize="18" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center"/>
                    <Entry Text="{Binding Username}" FontSize="16" WidthRequest="300" />
                    <Label Text="EMAIL*" 
                           FontSize="18" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center"/>
                    <Entry  Text="{Binding Email}" Keyboard="Email" FontSize="16" WidthRequest="300" />
                    <Label Text="TELÉFONO*" 
                           FontSize="18" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center"/>
                    <Entry Text="{Binding Phone}" Keyboard="Telephone" FontSize="16" WidthRequest="300"/>

                    <!-- Botón Guardar -->
                    <Button Text="Guardar" 
                            Command="{Binding UpdateCommand}" 
                            BackgroundColor="DarkGreen" 
                            TextColor="White"
                            Margin="0,20,0,0" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>