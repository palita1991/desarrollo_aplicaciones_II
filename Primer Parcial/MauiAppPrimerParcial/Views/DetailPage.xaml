<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAppPrimerParcial.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppPrimerParcial.Views.DetailPage"
             x:DataType="viewmodels:DetailViewModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadUserDetailsCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}" VerticalOptions="Start">

            <Label Text="{Binding StatusMessage}" TextColor="Red" HorizontalOptions="Center" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            <Frame CornerRadius="20"
                   HasShadow="True"
                   WidthRequest="350"
                   HorizontalOptions="Center"
                   BorderColor="{StaticResource Primary}"
                   IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="NOMBRE:" 
                           FontSize="18" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding CurrentUser.Name, FallbackValue='Cargando...'}" 
                           FontSize="16" 
                           HorizontalOptions="Center"/>
                    
                    <Label Text="USUARIO:" 
                           FontSize="18" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center" />
                    <Label Text="{Binding CurrentUser.Username, FallbackValue='Cargando...'}" 
                           FontSize="16" 
                           HorizontalOptions="Center"  />

                    <Label Text="EMAIL:"
                           FontSize="18" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center" />
                    <Label Text="{Binding CurrentUser.Email, FallbackValue='Cargando...'}" 
                           FontSize="16" 
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>