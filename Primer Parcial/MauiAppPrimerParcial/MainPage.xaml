<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiAppPrimerParcial.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppPrimerParcial.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="Listado de Usuarios">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
	<Grid RowDefinitions="Auto, Auto, *">
		<!-- Carga de datos -->
		<Button Grid.Row="0"
                Text="Cargar Datos"
                Command="{Binding LoadDataCommand}"
                Margin="15"
                IsEnabled="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}" />

		<!-- Mensaje de estado resultante -->
		<Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               TextColor="Gray"
               HorizontalOptions="Center"
               Margin="0,0,0,10" />

		<!-- Indicador de carga de datos -->
		<ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

		<!-- CollectionView para el listado -->
        <CollectionView Grid.Row="2"
                ItemsSource="{Binding Users}"
                SelectionMode="None"
                IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10,5" Padding="15" CornerRadius="8" HasShadow="True">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">

                            <!-- Columna 0: Datos apilados del usuario -->
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Nombre:" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding Name}"  FontSize="16" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Usuario:" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding Username}" FontSize="16" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Email:" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding Email}" FontSize="16" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Teléfono:" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding Phone}" FontSize="16" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Columna 1: Botón de detalle -->
                            <Button Grid.Column="1"
                                    Text="Ver Detalle"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=GoToDetailsCommand}"
                                    CommandParameter="{Binding Id}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
