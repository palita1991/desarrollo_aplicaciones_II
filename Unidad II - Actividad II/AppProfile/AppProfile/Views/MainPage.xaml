<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppProfile.MainPage"
             BackgroundColor="#000000">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <!-- Imagen de Perfil -->
            <Image Source="{Binding ProfileImageUrl}" 
                   WidthRequest="120" 
                   HeightRequest="120" 
                   Aspect="AspectFill" 
                   HorizontalOptions="Center"
                   Margin="0, 0, 0, 15">
                <Image.Clip>
                    <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" />
                </Image.Clip>
            </Image>

            <!-- Campo: Nombre -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Nombre completo" Style="{StaticResource FieldLabel}"/>
                <Entry Text="{Binding Name, Mode=TwoWay}" 
                       Placeholder="Ingresar nombre completo" 
                       ClearButtonVisibility="WhileEditing"/>

                <Label Text="{Binding NameError}" Style="{StaticResource ErrorLabel}"/>
            </VerticalStackLayout>

            <!-- Campo: Edad -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Edad" Style="{StaticResource FieldLabel}"/>
                <Entry Text="{Binding Age, Mode=TwoWay}" 
                       Placeholder="Ingresar edad" 
                       Keyboard="Numeric" 
                       TextChanged="OnEdadTextChanged"/>

                <Label Text="{Binding AgeError}" Style="{StaticResource ErrorLabel}"/>
            </VerticalStackLayout>

            <!-- Campo: Descripción -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Descripción" Style="{StaticResource FieldLabel}"/>
                <Editor Text="{Binding Description, Mode=TwoWay}" 
                        Placeholder="Descrición sobre el perfil..." 
                        HeightRequest="100" />
            </VerticalStackLayout>

            <Button Text="Guardar" 
                    Command="{Binding SaveCommand}" 
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,10,0,0" />

            <Border IsVisible="{Binding IsStatusVisible}"
                    BackgroundColor="#DCFCE7"
                    Stroke="{StaticResource SuccessColor}"
                    StrokeThickness="1"
                    Padding="16, 12"
                    HorizontalOptions="Center"
                    Margin="0, 10, 0, 0">

                <!-- Borde redondeado -->
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <!-- El texto dentro de la alerta -->
                <Label Text="{Binding StatusMessage}" 
                       TextColor="{StaticResource SuccessColor}" 
                       HorizontalOptions="Center" 
                       FontAttributes="Bold"
                       FontSize="13"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
