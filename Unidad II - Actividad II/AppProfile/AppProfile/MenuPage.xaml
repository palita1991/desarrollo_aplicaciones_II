<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppProfile.MenuPage"
             BackgroundColor="#000000">
    <VerticalStackLayout Padding="30" Spacing="30" VerticalOptions="Center">
        <!-- ## AVATAR DE PERFIL ## -->
        <Image Source="{Binding ProfileImageUrl}" 
                   WidthRequest="120" HeightRequest="120" 
                   Aspect="AspectFill" HorizontalOptions="Center">
            <Image.Clip>
                <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" />
            </Image.Clip>
        </Image>

        <!-- ## DATOS DEL ALUMNO ## -->
        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,0,0,20">
            <Label Text="{Binding Name}" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center"/>

            <Label Text="{Binding Age, StringFormat='Edad: {0} años'}" 
                       FontSize="16" 
                       TextColor="#94A3B8" 
                       HorizontalTextAlignment="Center"/>

            <Label Text="{Binding Description}" 
                       FontSize="14" 
                       TextColor="#94A3B8" 
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       MaximumWidthRequest="300"/>
        </VerticalStackLayout>

        <!-- Botón para viajar al formulario -->
        <Button Text="Editar Perfil" 
                    Command="{Binding NavigateToProfileCommand}" 
                    BackgroundColor="#0288D1"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    Padding="0,12"/>
    </VerticalStackLayout>
</ContentPage>